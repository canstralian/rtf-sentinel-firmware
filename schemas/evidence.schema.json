{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-team-forge.dev/sentinel/evidence.schema.json",
  "title": "Sentinel Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "job_id",
    "device_id",
    "capability",
    "decision",
    "reason",
    "status",
    "elapsed_ms",
    "output_bytes"
  ],
  "properties": {
    "version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow", "deny"]},
    "reason": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "denied",
        "running",
        "completed",
        "cancelled",
        "runtime_exceeded",
        "output_exceeded",
        "failed"
      ]
    },
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "output_bytes": {"type": "integer", "minimum": 0},
    "previous_hash": {
      "type": ["string", "null"],
      "description": "Reserved for hash chaining; null until evidence chaining is implemented."
    },
    "record_hash": {
      "type": ["string", "null"],
      "description": "Reserved for canonical-record hashing; null until hashing is implemented."
    }
  }
}
